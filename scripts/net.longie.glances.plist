<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.longie.glances</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/glances</string>
        <string>-w</string>
        <string>--bind</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>61208</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/glances.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/glances.err</string>
</dict>
</plist>

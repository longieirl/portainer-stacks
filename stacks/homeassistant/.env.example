# homeassistant stack — set in Portainer UI per-stack (never commit real values)
#
# FEATURE FLAG: COMPOSE_PROFILES
#   Leave UNSET for Phase 1 (Home Assistant only, Tuya cloud integration — no
#     secrets needed below).
#   Set to `zigbee` for Phase 2 (adds mosquitto + zigbee2mqtt for local Zigbee).
#   SINGLE value only — comma-separated lists are truncated by a Portainer bug
#   (portainer/portainer#13033).
# COMPOSE_PROFILES=zigbee

# Host path for persistent data volumes — must be set in Portainer's Environment
# Variables UI. Must resolve to a path shared with Docker Desktop
# (Preferences -> Resources -> File Sharing).
# Example: DOCKER_DATA_HOME=/Users/yourname/docker-data
DOCKER_DATA_HOME=

# --- Phase 2 (required when COMPOSE_PROFILES=zigbee) ---

# LAN IP of the SLZB-06 network Zigbee coordinator. zigbee2mqtt connects via
# tcp://${SLZB06_HOST}:6638 (confirm the port in the SLZB-06 web UI).
# SLZB06_HOST=

# Zigbee2MQTT frontend auth token (the frontend has NO auth by default and is
# proxied at z2m.longie.net). Generate once: openssl rand -hex 32
# Z2M_AUTH_TOKEN=

# Homepage stack — set in Portainer UI per-stack (never commit real values)
# Also requires DOCKER_DATA_HOME and DOCKER_SHARED_HOME set in Portainer UI

# Host user IDs — run `id` on the host to get these
PUID=1000
PGID=1000

# Plex — Settings → General (show advanced) → Plex Token
PLEX_TOKEN=

# Tautulli — Settings → Web Interface → API Key
TAUTULLI_API_KEY=

# Sonarr — Settings → General → API Key
SONARR_API_KEY=

# Seerr — Settings → General → API Key
SEERR_API_KEY=

# qBittorrent WebUI credentials
QBIT_USERNAME=admin
QBIT_PASSWORD=

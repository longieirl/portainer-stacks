# Homepage stack — set in Portainer UI per-stack (never commit real values)
# Also requires DOCKER_DATA_HOME and DOCKER_SHARED_HOME set in Portainer UI

# Allowed hosts — comma-separated, no spaces (default covers LAN IP + public domain)
HOMEPAGE_ALLOWED_HOSTS=home.longie.net,192.168.1.6:3000


PUID=1000
PGID=1000

# Plex — Settings → General (show advanced) → Plex Token
PLEX_TOKEN=

# Tautulli — Settings → Web Interface → API Key
TAUTULLI_API_KEY=

# Sonarr — Settings → General → API Key
SONARR_API_KEY=

# Seerr — Settings → General → API Key
SEERR_API_KEY=

# qBittorrent WebUI credentials
QBIT_USERNAME=admin
QBIT_PASSWORD=

# Deluge WebUI password
DELUGE_PASSWORD=

# Prowlarr — Settings → General → API Key
PROWLARR_API_KEY=

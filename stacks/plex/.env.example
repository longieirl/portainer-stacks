# Plex monitoring stack — set in Portainer UI per-stack (never commit real values)
# Also requires DOCKER_DATA_HOME set in Portainer UI Environment Variables tab at creation/redeploy time

# Host user IDs — used by Tautulli; run `id` on the host to get these
PUID=1000
PGID=1000

# Plex token — Plex Settings → General (show advanced) → Plex Token
# Used when configuring Tautulli and Seerr post-deploy (not injected here)
PLEX_TOKEN=
